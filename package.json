{
  "name": "ipxdata-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:analytics": "node --test tests/analytics-time.test.mjs tests/counting-daily-parity.test.mjs tests/counting-analysis-refresh.test.mjs tests/counting-live-cache-freshness.test.mjs",
    "test:audit": "node --test tests/audit.test.mjs",
    "test:auth": "node --test tests/auth-session.test.mjs",
    "test:demographics": "node --test tests/demographics.test.mjs tests/demographics-analysis-refresh.test.mjs tests/demographics-live-refresh.test.mjs tests/demographics-visual.test.mjs tests/demographics-presentation.test.mjs tests/demographics-chart-options.test.mjs tests/demographics-crossing-options.test.mjs tests/demographics-widget-settings.test.mjs tests/demographics-temporal.test.mjs tests/demographics-temporal-live-parity.test.mjs tests/demographics-temporal-preferences.test.mjs tests/demographics-temporal-chart-options.test.mjs tests/demographics-comparison-window.test.mjs tests/demographics-semantic-colors.test.mjs tests/demographics-axis-containment.test.mjs",
    "test:crud": "node --test tests/infrastructure-crud.test.mjs tests/scenario-crud-bulk.test.mjs tests/crud-selection-ui.test.mjs",
    "test:ai": "node --test tests/ai-insights.test.mjs tests/ai-analysis-snapshot.test.mjs tests/ai-insights-pdf.test.mjs",
    "test:login-ui": "node --test tests/login-ui.test.mjs",
    "test:layout": "node --test tests/card-layout-packing.test.mjs",
    "test:responsive": "node --test tests/responsive-select.test.mjs tests/responsive-admin.test.mjs tests/dashboard-responsive-controls.test.mjs tests/focus-containment.test.mjs tests/admin-field-containment.test.mjs tests/dashboard-control-containment.test.mjs",
    "verify:responsive": "node tools/verify-responsive.mjs",
    "verify:demographics": "node tools/verify-demographics.mjs",
    "verify:demographics-circular": "node tools/verify-demographics.mjs --circular",
    "verify:demographics-temporal": "node tools/verify-demographics.mjs --temporal",
    "test:performance": "node --test tests/resource-refresh-performance.test.mjs tests/counting-live-performance.test.mjs tests/counting-history-performance.test.mjs tests/occupancy-dashboard-performance.test.mjs",
    "test:modules": "node --test tests/module-access.test.mjs tests/dashboard-surface-access.test.mjs tests/user-access-catalog.test.mjs tests/user-access-editor.test.mjs tests/user-access-grid.test.mjs",
    "test:occupancy-range": "node --test tests/occupancy-range-plan.test.mjs",
    "test:occupancy-duration": "node --test tests/occupancy-duration-insights.test.mjs tests/occupancy-duration-insights-query.test.mjs tests/occupancy-duration-insights-charts.test.mjs",
    "test:occupancy-widgets": "node --test tests/occupancy-comparison-heatmap-axes.test.mjs tests/occupancy-widget-controls.test.mjs tests/occupancy-comparison-selection.test.mjs",
    "test:heatmap": "node --test tests/heatmap-intensity-palette.test.mjs",
    "test:chart-labels": "node --test tests/chart-zero-labels.test.mjs tests/chart-export-zero-labels.test.mjs tests/custom-chart-zero-labels.test.mjs",
    "test:tenant-scope": "node --test tests/tenant-scope-propagation.test.mjs",
    "test:user-grid": "node --test tests/user-grid.test.mjs tests/user-preferences-persistence.test.mjs",
    "test": "npm run test:analytics && npm run test:audit && npm run test:auth && npm run test:demographics && npm run test:crud && npm run test:ai && npm run test:login-ui && npm run test:layout && npm run test:responsive && npm run test:performance && npm run test:modules && npm run test:occupancy-range && npm run test:occupancy-duration && npm run test:occupancy-widgets && npm run test:heatmap && npm run test:chart-labels && npm run test:tenant-scope && npm run test:user-grid",
    "check:production": "npm run lint && npm run typecheck && npm test && npm run build",
    "context:skeleton": "node tools/generate-code-skeleton.mjs",
    "context:pack": "repomix --config repomix.config.json",
    "context:pack:compressed": "repomix --config repomix.config.json --compress -o context/ipxdata-frontend-compressed.xml",
    "context:all": "npm run context:skeleton && npm run context:pack"
  },
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-tabs": "1.1.13",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "echarts": "6.1.0",
    "exceljs": "4.4.0",
    "jspdf": "4.2.1",
    "lucide-react": "1.17.0",
    "next": "16.3.0",
    "openai": "6.16.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "0.0.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "0.1.1",
    "@types/node": "25.9.1",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.5.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "postcss": "8.5.26",
    "repomix": "1.16.0",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "1.0.7",
    "typescript": "6.0.3"
  },
  "overrides": {
    "postcss": "8.5.26",
    "uuid": "11.1.1"
  }
}
