    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "autoprefixer": "10.5.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "postcss": "8.5.26",
    "repomix": "1.16.0",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "1.0.7",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "ws": "8.21.3"
  },
