    "test:occupancy-range": "node --import tsx --test tests/occupancy-range-plan.test.mts",
    "test:occupancy-duration": "node --import tsx --test tests/occupancy-duration-insights.test.mts tests/occupancy-duration-insights-query.test.mts tests/occupancy-duration-insights-charts.test.mts tests/occupancy-analysis-duration-integration.test.mts tests/occupancy-state-metrics.test.mts tests/occupancy-state-widget-integration.test.mts tests/occupancy-loitering.test.mts tests/occupancy-loitering-query.test.mts tests/occupancy-loitering-temporal.test.mts tests/occupancy-loitering-temporal-widgets.test.mts tests/occupancy-loitering-integration.test.mts",
    "test:occupancy-widgets": "node --import tsx --test tests/occupancy-comparison-heatmap-axes.test.mts tests/occupancy-scenario-heatmap.test.mts tests/occupancy-current-comparison-axis.test.mts tests/occupancy-widget-controls.test.mts tests/occupancy-comparison-selection.test.mts tests/occupancy-analysis-custom-integration.test.mts tests/occupancy-analysis-configuration-parity.test.mts tests/occupancy-visual-settings.test.mts",
    "test:occupancy-regressions": "node --import tsx --test tests/occupancy-aggregate-contract.test.mts tests/occupancy-area-catalog-scope.test.mts tests/occupancy-duration-cache-freshness.test.mts tests/occupancy-live-regressions.test.mts tests/occupancy-reports-time-zone.test.mts tests/occupancy-comparison-company-time-zone.test.mts tests/occupancy-duration-compact-bounds.test.mts tests/occupancy-object-class-requests.test.mts tests/occupancy-reports-object-class.test.mts tests/occupancy-scenario-manager-object-class.test.mts tests/occupancy-snapshot-coverage.test.mts",
    "test:heatmap": "node --import tsx --test tests/heatmap-intensity-palette.test.mts",
    "test:chart-labels": "node --import tsx --test tests/chart-zero-labels.test.mts tests/chart-export-zero-labels.test.mts tests/custom-chart-zero-labels.test.mts",
    "test:tenant-scope": "node --import tsx --test tests/tenant-scope-propagation.test.mts",
    "test:user-grid": "node --import tsx --test tests/user-grid.test.mts tests/user-grid-readiness.test.mts tests/user-preferences-persistence.test.mts",
    "test": "node --import tsx tools/run-tests.mts",
    "check:production": "npm run lint && npm run typecheck && npm test && npm run build",
    "context:skeleton": "node --import tsx tools/generate-code-skeleton.mts",
    "context:pack": "repomix --config repomix.config.json",
    "context:pack:compressed": "repomix --config repomix.config.json --compress -o context/ipxdata-frontend-compressed.xml",
    "context:all": "npm run context:skeleton && npm run context:pack",
    "typecheck:app": "tsc --noEmit",
    "typecheck:tooling": "tsc --project tsconfig.tooling.json",
    "test:tooling": "node --import tsx --test tests/typescript-tooling.test.mts",
    "verify:brand-mark": "node --import tsx tools/verify-brand-mark.mts"
  },
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.15",
