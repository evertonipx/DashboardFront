    "test:login-ui": "node --import tsx --test tests/login-ui.test.mts",
    "test:layout": "node --import tsx --test tests/card-layout-packing.test.mts",
    "test:responsive": "node --import tsx --test tests/responsive-select.test.mts tests/responsive-admin.test.mts tests/dashboard-responsive-controls.test.mts tests/focus-containment.test.mts tests/admin-field-containment.test.mts tests/dashboard-control-containment.test.mts tests/brand-mark.test.mts",
