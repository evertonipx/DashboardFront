# Obrigatorio em producao: endereco fixo e confiavel da API.
# O proxy recusa destino derivado de headers em producao.
IPXDATA_API_URL=http://127.0.0.1:8080
IPXDATA_API_PROTOCOL=http
IPXDATA_API_PORT=8080

# Ajuste quando a API estiver em outro host.
# IPXDATA_API_URL=https://api.exemplo.com

# Normalmente deixe em branco ou mantenha /api/v1 para usar o proxy do Next.
# Use uma URL absoluta apenas se o backend estiver com CORS liberado para o frontend.
NEXT_PUBLIC_IPXDATA_API_BASE_URL=/api/v1

# Insights por IA. A chave de cada cliente e cadastrada somente pelo
# superadmin na tela Configuracao IA e fica cifrada no volume local .ipxdata.
# Nunca use prefixo NEXT_PUBLIC_ nem grave uma chave real neste arquivo.
OPENAI_MODEL=gpt-5.6-terra
# Allowlist CSV de modelos que o superadmin pode selecionar; o modelo padrao
# acima e sempre incluido mesmo quando esta lista for omitida.
OPENAI_ALLOWED_MODELS=gpt-5.6-terra
# Opcional: volume persistente exclusivo da configuracao IA.
# IPXDATA_AI_SETTINGS_DIRECTORY=D:\IPXDataData\ai-settings

# Fuso IANA empresarial do ambiente. E usado como politica explicita apenas
# quando JWT, /auth/me e catalogo nao trazem um fuso especifico para o tenant.
# Um timezone valido informado pela empresa sempre tem precedencia.
NEXT_PUBLIC_IPXDATA_DEFAULT_COMPANY_TIME_ZONE=America/Sao_Paulo

# Ano inicial consultado pela matriz anual dos Relatorios.
# Mantenha estavel para acrescentar novos anos sem remover o historico antigo.
NEXT_PUBLIC_REPORT_HISTORY_START_YEAR=2020

# Usado pelos scripts de inicializacao deste projeto.
IPXDATA_FRONTEND_HOST=0.0.0.0
IPXDATA_FRONTEND_PORT=3000

# Opcional: marcas customizadas para a tela de login.
# A chave e resolvida por URL (?empresa=cliente-a) ou subdominio (cliente-a.seudominio.com).
# Coloque os logos em public/brands/<chave>/logo.png antes do build.
# NEXT_PUBLIC_IPXDATA_LOGIN_BRANDS=[{"key":"cliente-a","companyName":"Cliente A","logoUrl":"/brands/cliente-a/logo.png","accentColor":"#0B4EA2","subtitle":"IPXData"}]
